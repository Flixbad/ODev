# ODev Gestion — Apache / Hostinger
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bloquer l'accès direct aux dossiers sensibles
  RewriteRule ^(app|sql|storage)/ - [F,L]
  RewriteRule ^config\.php$ - [F,L]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
